{
  "name": "zarinpal-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "data:sales-pulse": "node scripts/generate-sales-pulse-data.mjs",
    "data:sales-pulse:ai": "node --env-file-if-exists=.env.local scripts/enrich-sales-pulse-ai.mjs",
    "data:buyer-loyalty": "node scripts/generate-buyer-loyalty-data.mjs",
    "data:peer-position": "node scripts/generate-peer-position-data.mjs",
    "data:payment-health": "node scripts/generate-payment-health-data.mjs",
    "predev": "node scripts/generate-sales-pulse-data.mjs --if-stale && node scripts/generate-buyer-loyalty-data.mjs --if-stale && node scripts/generate-peer-position-data.mjs --if-stale && node scripts/generate-payment-health-data.mjs --if-stale",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "node scripts/generate-sales-pulse-data.mjs --if-stale && node scripts/generate-buyer-loyalty-data.mjs --if-stale && node scripts/generate-peer-position-data.mjs --if-stale && node scripts/generate-payment-health-data.mjs --if-stale",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.32.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.11.3",
    "ai": "^7.0.70",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.33.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "react-jsx-parser": "^2.4.1",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "ZarinPal Dashboard"
}
