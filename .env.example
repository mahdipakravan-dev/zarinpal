# Create .env.local locally. Never commit the real API key.
LIARA_AI_URL=https://ai.liara.ir/api/your-service-id/v1/chat/completions
LIARA_AI_API_KEY=replace-with-a-rotated-key
LIARA_AI_MODEL=openai/gpt-5.6-luna

# Optional safeguards. Concurrency is clamped to 1..5.
LIARA_AI_CONCURRENCY=2
LIARA_AI_TIMEOUT_MS=45000
LIARA_AI_LOG_PATH=.sales-pulse-logs/liara-ai.jsonl
LIARA_AI_LOG_CONSOLE=true

# Browser streaming mode. These values are public in the client bundle; use test credentials only.
VITE_LIARA_AI_URL=https://ai.liara.ir/api/your-service-id/v1/chat/completions
VITE_LIARA_AI_API_KEY=replace-with-a-test-key
VITE_LIARA_AI_MODEL=openai/gpt-5.6-luna
